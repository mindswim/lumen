# Lumen Environment Variables
# Copy this file to .env.local and fill in your keys

# Anthropic API Key (required for AI editing features)
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: pin a different Claude model. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# Fal.ai API Key (required for image generation)
# Get yours at: https://fal.ai
FAL_KEY=

# Optional shared local workspace directory. Defaults to .lumen/ in this project.
LUMEN_WORKSPACE_DIR=
